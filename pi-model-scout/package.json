  "type": "module",
  "license": "MIT",
  "author": "cobomi GmbH <info@cobomi.com>",
  "homepage": "https://github.com/cobomi-lab/pi-model-scout#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobomi-lab/pi-model-scout.git"
  },
  "bugs": {
    "url": "https://github.com/cobomi-lab/pi-model-scout/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "openai-compatible",
    "model-discovery",
    "unsloth",
    "vllm",
    "lm-studio",
    "ollama",
    "litellm"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/openai-discovery.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
