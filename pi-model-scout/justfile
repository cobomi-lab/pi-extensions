# pi-model-scout — development and release tasks
set shell := ["bash", "-euo", "pipefail", "-c"]

NAME := `node -p "require('./package.json').name"`
VERSION := `node -p "require('./package.json').version"`
GIT_REMOTE := 'origin'
RELEASE_BRANCH := 'main'
# release tags look like v<version> (created by npm version)
TAG_PREFIX := 'v'
# registry the package is published to
NPM_REGISTRY := 'https://registry.npmjs.org/'

alias t := typecheck
alias c := clean
alias ck := check
alias pk := pack
alias rel := release

# list all available recipes
default:
    just --list

[private]
require-node:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v node >/dev/null; then
        echo "error: node is not installed -- see https://nodejs.org/" >&2
        exit 1
    fi
    major=$(node -p 'process.versions.node.split(".")[0]')
    if [ "$major" -lt 20 ]; then
        echo "error: node >= 20 is required (found $(node -v))" >&2
        exit 1
    fi

[private]
require-deps: require-node
    #!/usr/bin/env bash
    set -euo pipefail
    [ -d node_modules ] || npm install --no-audit --no-fund

# install dev dependencies (TypeScript, pi types)
[group: 'setup']
setup: require-node
    npm install --no-audit --no-fund

# ─── pi (try the extension from this checkout) ──────────────────────────────

# usage: just try                -> pi with this extension loaded
#        just try --model x      -> extra args go to pi
[group: 'pi']
try *ARGS: require-deps
    pi -e . {{ ARGS }}

# list the models pi sees with the extension loaded (uses your real models.json)
[group: 'pi']
models: require-deps
    pi -e . --list-models

# install this checkout into pi (user scope)
[group: 'pi']
install-local:
    pi install "$(pwd)"

# remove the local install from pi
[group: 'pi']
uninstall-local:
    pi remove "$(pwd)"

# ─── checks ─────────────────────────────────────────────────────────────────

# type-check the extension with tsc
[group: 'check']
typecheck: require-deps
    npm run typecheck

# fail if placeholders (YOUR_NAME, YOUR_GITHUB_USER, …) are still present
[group: 'check']
check-placeholders:
    @! grep -nE "YOUR_[A-Z_]+|YOUR NAME|you@example\.com" package.json LICENSE README.md \
        || { echo "✗ replace the placeholders above before releasing"; exit 1; }
    @echo "✓ no placeholders"

# show what would be published
[group: 'check']
pack-preview:
    npm pack --dry-run

# all pre-release checks (what CI should run)
[group: 'check']
check: typecheck check-placeholders pack-preview

# ─── packaging ──────────────────────────────────────────────────────────────

# build the npm tarball locally for inspection
[group: 'build']
pack:
    npm pack

# remove node_modules and packed tarballs
[group: 'build']
clean:
    rm -rf node_modules *.tgz

# ─── git ────────────────────────────────────────────────────────────────────

[private]
require-clean:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "$(git branch --show-current)" != "{{ RELEASE_BRANCH }}" ]; then
        echo "error: not on the {{ RELEASE_BRANCH }} branch" >&2
        exit 1
    fi
    if ! git diff --quiet || ! git diff --cached --quiet; then
        echo "error: the working tree has uncommitted changes -- commit or stash them first" >&2
        exit 1
    fi

# ─── release ────────────────────────────────────────────────────────────────

[private]
require-token:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -n "${NPM_TOKEN:-}" ]; then
        exit 0
    fi
    if ! npm whoami --registry {{ NPM_REGISTRY }} >/dev/null 2>&1; then
        echo "error: not logged in to the npm registry and NPM_TOKEN is not set" >&2
        echo "       log in with: npm login" >&2
        exit 1
    fi

# usage: just bump patch          -> next patch version
#        just bump 0.2.0          -> exact version
# set the version with npm, then commit and tag it
[group: 'release']
bump LEVEL_OR_VERSION: require-clean
    npm version {{ LEVEL_OR_VERSION }} --no-git-tag-version
    git add package.json
    git commit -m "Bump {{ NAME }} version to $(node -p "require('./package.json').version")"
    git tag -a {{ TAG_PREFIX }}$(node -p "require('./package.json').version") -m "Release {{ NAME }} v$(node -p "require('./package.json').version")"

# push the current branch and the tag for the version in package.json (makes `pi install git:...@vX.Y.Z` work)
[group: 'release']
push: require-clean
    git push --atomic {{ GIT_REMOTE }} HEAD "refs/tags/{{ TAG_PREFIX }}$(node -p "require('./package.json').version")"

# publish to npm (token: NPM_TOKEN, else the local npm login)
[group: 'release']
publish: require-token
    npm publish --registry {{ NPM_REGISTRY }}

# usage: just release patch       -> full release with next version
#        just release 0.2.0       -> full release at an exact version
# check, bump, push and publish to npm
[group: 'release']
release LEVEL_OR_VERSION: require-clean check (bump LEVEL_OR_VERSION) push publish
    @echo "✓ released {{ NAME }} v$(node -p "require('./package.json').version")"

# release to git only (no npm)
[group: 'release']
release-git LEVEL_OR_VERSION: require-clean check (bump LEVEL_OR_VERSION) push
